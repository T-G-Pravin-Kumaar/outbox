# ==============================================================================
# ReachInbox Outbox Scheduler - Unified Environment Variables Template
# ==============================================================================

# ==============================================================================
# 1. APPLICATION & SERVER PORTS
# ==============================================================================
PORT=5000
FRONTEND_PORT=3000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ==============================================================================
# 2. VERCEL FRONTEND CONFIGURATION (Add these to Vercel Project Settings)
# ==============================================================================
NEXT_PUBLIC_BACKEND_URL=https://your-backend-api.up.railway.app
NEXT_PUBLIC_API_URL=https://your-backend-api.up.railway.app/api
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
NEXT_PUBLIC_SLACK_CLIENT_ID=your-slack-client-id

# ==============================================================================
# 3. DOCKER FRONTEND BUILD ARGS (Used when building frontend container)
# ==============================================================================
FRONTEND_NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
FRONTEND_NEXT_PUBLIC_API_URL=http://localhost:5000/api

# ==============================================================================
# 4. DATABASE (PostgreSQL / Neon / Supabase / Render Postgres)
# ==============================================================================
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=outbox_email_db
DB_PORT=5432
# For local Docker Compose, use:
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/outbox_email_db?schema=public
# For Cloud (Neon / Supabase), use:
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/neondb?sslmode=require

# ==============================================================================
# 5. REDIS & QUEUE (Local Docker or Upstash / Managed Redis)
# ==============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
# For Cloud (Upstash), use:
# REDIS_URL=rediss://default:password@xxxx.upstash.io:6379

# ==============================================================================
# 6. ELASTICSEARCH (Local Docker or Bonsai / Elastic Cloud)
# ==============================================================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX=emails
ELASTICSEARCH_PORT=9200
# For Cloud, use:
# ELASTICSEARCH_URL=https://elastic:pass@your-cluster.es.io:9243

# ==============================================================================
# 7. SECURITY & AUTHENTICATION SECRETS
# ==============================================================================
JWT_SECRET=super_secret_jwt_key_outbox_reachinbox_2026
SESSION_SECRET=super_secret_session_key_outbox_2026
ADMIN_PASSWORD=admin

# ==============================================================================
# 8. GOOGLE OAUTH 2.0
# ==============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ==============================================================================
# 9. SLACK OAUTH & NOTIFICATIONS (Optional)
# ==============================================================================
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:5000/api/slack/callback
SLACK_SCOPES=chat:write,incoming-webhook

# ==============================================================================
# 10. SMTP / EMAIL TRANSPORTER (Ethereal / SendGrid / AWS SES / Postmark)
# ==============================================================================
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Outbox Scheduler <no-reply@outbox.reachinbox.ai>

# ==============================================================================
# 11. RATE LIMITING & WORKER CONCURRENCY
# ==============================================================================
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=5
MIN_DELAY_SECONDS=2
WORKER_CONCURRENCY=5
