# ==============================================================================
# Frontend Environment Configuration Template
# ==============================================================================

# Backend API Endpoint
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Google OAuth Client ID (for direct frontend sign-in buttons if needed)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Slack OAuth Client ID (for Connect Slack dialog)
NEXT_PUBLIC_SLACK_CLIENT_ID=your-slack-client-id
